--- a/pjsip/src/pjsua-lib/pjsua_call.c
+++ b/pjsip/src/pjsua-lib/pjsua_call.c
@@ -1538,6 +1538,28 @@
  * Handle incoming INVITE request.
  * Called by pjsua_core.c
  */
+
+/* JFC: does the first Route of the dialog already point at the account's proxy? */
+static pj_bool_t jfc_route_has_proxy(const pjsip_route_hdr *dlg_rs,
+                                     const pjsip_route_hdr *acc_rs)
+{
+    const pjsip_route_hdr *first = dlg_rs->next;
+    const pjsip_route_hdr *proxy = acc_rs->next;
+    const pjsip_sip_uri *u1, *u2;
+
+    if (first == dlg_rs || proxy == acc_rs)
+        return PJ_FALSE;
+    if (!PJSIP_URI_SCHEME_IS_SIP(first->name_addr.uri) &&
+        !PJSIP_URI_SCHEME_IS_SIPS(first->name_addr.uri))
+        return PJ_FALSE;
+    if (!PJSIP_URI_SCHEME_IS_SIP(proxy->name_addr.uri) &&
+        !PJSIP_URI_SCHEME_IS_SIPS(proxy->name_addr.uri))
+        return PJ_FALSE;
+    u1 = (const pjsip_sip_uri*) pjsip_uri_get_uri(first->name_addr.uri);
+    u2 = (const pjsip_sip_uri*) pjsip_uri_get_uri(proxy->name_addr.uri);
+    return pj_stricmp(&u1->host, &u2->host) == 0 && u1->port == u2->port;
+}
+
 pj_bool_t pjsua_call_on_incoming(pjsip_rx_data *rdata)
 {
     pj_str_t contact;
@@ -1963,6 +1985,35 @@
     pjsua_init_tpselector(acc_id, &tp_sel);
     pjsip_dlg_set_transport(dlg, &tp_sel);
 
+    /* JFC: pjsua_call_make_call() puts the account's proxy in the dialog's
+     * route set, but incoming calls never did. Then BYE / re-INVITE (hold) /
+     * UPDATE for an INCOMING call were sent straight to the caller's Contact
+     * instead of through the router's TLS proxy, and were lost (hang-up only
+     * took effect after a timeout, hold did nothing). Prepend the proxy route
+     * to whatever Record-Route set the INVITE gave us.
+     */
+    if (!pj_list_empty(&pjsua_var.acc[acc_id].route_set) &&
+        !jfc_route_has_proxy(&dlg->route_set,
+                             &pjsua_var.acc[acc_id].route_set))
+    {
+        pjsip_route_hdr merged, *r;
+
+        pj_list_init(&merged);
+        r = pjsua_var.acc[acc_id].route_set.next;
+        while (r != &pjsua_var.acc[acc_id].route_set) {
+            pj_list_push_back(&merged, pjsip_hdr_clone(dlg->pool, r));
+            r = r->next;
+        }
+        r = dlg->route_set.next;
+        while (r != &dlg->route_set) {
+            pj_list_push_back(&merged, pjsip_hdr_clone(dlg->pool, r));
+            r = r->next;
+        }
+        pjsip_dlg_set_route_set(dlg, &merged);
+        PJ_LOG(4,(THIS_FILE, "Call %d: incoming dialog routed via account proxy",
+                  call_id));
+    }
+
     /* Create and attach pjsua_var data to the dialog */
     call->inv = inv;